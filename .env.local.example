# Copia este archivo a .env.local y completa con los valores del MISMO
# proyecto de Supabase que usa la app de Flutter, para que una cuenta
# funcione igual en la web y en la app.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Solo para uso en el servidor (panel admin) — NUNCA exponer al navegador.
# Se encuentra en Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# El chat de "Escucha activa" NO necesita variables acá — llama a la
# Supabase Edge Function "support-chat" (ver supabase/functions/), que es
# donde vive la clave de Anthropic (como secreto de Supabase, no acá).

# --- Cobro de la membresía (la web funciona sin esto; los botones de pago
# --- muestran "no configurado" hasta completar cada bloque) ---
# URL pública del sitio (para los enlaces de retorno de las pasarelas).
# En local puede omitirse; en producción poner p. ej. https://prisma.example.com
APP_URL=

# Wompi (Colombia, cobra en COP). Dashboard de Wompi > Desarrolladores.
# Con llaves pub_test_… funciona en sandbox; con pub_prod_… cobra de verdad.
# Webhook a registrar en Wompi: {APP_URL}/api/webhooks/wompi
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Pesos colombianos por 1 USD para convertir el precio de la membresía.
WOMPI_COP_PER_USD=

# PayPal (cobra en USD). developer.paypal.com > Apps & Credentials.
# PAYPAL_ENV=live en producción; cualquier otro valor usa el sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Tarea diaria que da de baja membresías vencidas (vercel.json la agenda).
# Genera un valor largo y aleatorio, también como variable en Vercel.
CRON_SECRET=
